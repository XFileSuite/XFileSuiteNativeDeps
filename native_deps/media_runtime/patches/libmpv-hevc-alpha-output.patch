+// FFmpeg's HEVC Alpha decoder offers both yuva* and yuv* output formats.
+// The former is not merely a conversion preference: selecting it tells the
+// decoder to decode and merge the auxiliary alpha layer. Prefer it for the
+// software HEVC path so that libmpv does not silently retain base-layer-only
+// yuv420p frames.
+static enum AVPixelFormat get_format_hevc_alpha(struct AVCodecContext *avctx,
+                                                const enum AVPixelFormat *fmt)
+{
+    for (int i = 0; fmt[i] != AV_PIX_FMT_NONE; i++) {
+        const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(fmt[i]);
+        if (desc && (desc->flags & AV_PIX_FMT_FLAG_ALPHA)) {
+            return fmt[i];
+        }
+    }
+
+    return avcodec_default_get_format(avctx, fmt);
+}
